/quiz/                https://github.com/jukaLang/Juka                             301
/blog                 /                                                            301
/blog/*               /                                                            301

# The translated copies of the old site. Each registered its own service
# worker; serve the clean-up worker at those paths (200 = rewrite: browsers
# refuse a redirected service-worker update), before the catch-alls below.
/ru/sw.js             /sw.js                                                       200
/zh/sw.js             /sw.js                                                       200
/es/sw.js             /sw.js                                                       200
/fr/sw.js             /sw.js                                                       200
/de/sw.js             /sw.js                                                       200
/ru                   /                                                            301
/zh                   /                                                            301
/es                   /                                                            301
/fr                   /                                                            301
/de                   /                                                            301
/ru/*                 /:splat                                                      301
/zh/*                 /:splat                                                      301
/es/*                 /:splat                                                      301
/fr/*                 /:splat                                                      301
/de/*                 /:splat                                                      301

# Old image and manifest paths that other sites may still embed
/img/juka.png         /assets/img/icon-512.png                                     301
/img/juka_app.png     /apple-touch-icon.png                                        301
/img/logo.svg         /assets/img/jukahub-logo.svg                                 301
/img/favicon.png      /favicon.png                                                 301
/manifest.json        /site.webmanifest                                            301
