# Redirects for jukalang.com (Netlify reads this file).
#
# Until November 2026 jukalang.com was a Docusaurus site for the Juka
# programming language, in six languages. Its pages are gone; these rules send
# old links somewhere useful instead of to a 404. The language itself lives at
# github.com/jukaLang/Juka.

# Pages that have a direct successor here
/download             /install/                                                    301
/download/            /install/                                                    301
/community            /#community                                                  301
/community/           /#community                                                  301
/contact              /#community                                                  301
/contact/             /#community                                                  301
/tools                /features/                                                   301
/tools/               /features/                                                   301
/donate               /                                                            301
/donate/              /                                                            301
/changelog            https://github.com/jukaLang/JukaHubV2/blob/main/CHANGELOG.md 301
/changelog/           https://github.com/jukaLang/JukaHubV2/blob/main/CHANGELOG.md 301
/license              https://github.com/jukaLang/JukaHubV2/blob/main/LICENSE      301
/license/             https://github.com/jukaLang/JukaHubV2/blob/main/LICENSE      301

# The Juka language's documentation, guide, examples and quiz
/docs                 https://github.com/jukaLang/Juka                             301
/docs/*               https://github.com/jukaLang/Juka                             301
/learn                https://github.com/jukaLang/Juka                             301
/learn/               https://github.com/jukaLang/Juka                             301
/examples             https://github.com/jukaLang/Juka                             301
